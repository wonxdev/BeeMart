@page
@model BeeMart.Web.Pages.Auth.AccessDeniedModel
@{
    ViewData["Title"] = "Akses Ditolak (Access Denied)";
}

<div class="container-narrow">
    <section class="card card-amber-top">
        <div class="card-header">
            <h1 class="card-title text-danger">Akses Ditolak (Access Denied)</h1>
            <span class="badge badge-danger">403 Forbidden</span>
        </div>
        <div class="card-body">
            <p class="text-secondary">
                Maaf, akun Anda tidak memiliki izin (role) yang cukup untuk mengakses halaman ini.
            </p>
            <div class="d-flex gap-2 mt-4">
                <a asp-page="/Index" class="btn btn-secondary">Kembali ke Beranda</a>
                <a asp-page="/Auth/Login" class="btn btn-accent">Halaman Login</a>
            </div>
        </div>
    </section>
</div>
