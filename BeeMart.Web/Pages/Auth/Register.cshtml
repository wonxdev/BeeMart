@page
@model BeeMart.Web.Pages.Auth.RegisterModel
@{
    ViewData["Title"] = "Register Akun";
}

<div class="container-narrow">
    <section class="card card-auth">
        <div class="text-center mb-4">
            <h1 class="text-accent mb-1">Register Akun</h1>
            <p class="text-muted">Daftarkan akun baru Kasir atau Admin BeeMart</p>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <div class="alert alert-danger" role="alert">
                <span>@Model.ErrorMessage</span>
                <button type="button" class="alert-close" data-dismiss="alert" aria-label="Close">&times;</button>
            </div>
        }

        <form method="post" novalidate>
            <div class="form-group">
                <label asp-for="Input.Username" class="form-label">Username</label>
                <input asp-for="Input.Username"
                       class="form-control"
                       placeholder="Masukkan username unik"
                       autocomplete="username"
                       required />
                <span asp-validation-for="Input.Username" class="validation-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Input.FullName" class="form-label">Full Name</label>
                <input asp-for="Input.FullName"
                       class="form-control"
                       placeholder="Masukkan nama lengkap"
                       autocomplete="name"
                       required />
                <span asp-validation-for="Input.FullName" class="validation-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Input.Password" class="form-label">Password</label>
                <input asp-for="Input.Password"
                       type="password"
                       class="form-control"
                       placeholder="Masukkan password"
                       autocomplete="new-password"
                       required />
                <span asp-validation-for="Input.Password" class="validation-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Input.RePassword" class="form-label">Re-Password</label>
                <input asp-for="Input.RePassword"
                       type="password"
                       class="form-control"
                       placeholder="Ulangi password"
                       autocomplete="new-password"
                       required />
                <span asp-validation-for="Input.RePassword" class="validation-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Input.Role" class="form-label">Role</label>
                <select asp-for="Input.Role" class="form-select" required>
                    <option value="Cashier">Kasir</option>
                    <option value="Admin">Admin</option>
                </select>
                <span asp-validation-for="Input.Role" class="validation-error"></span>
            </div>

            <button type="submit" class="btn btn-accent btn-block btn-lg mt-4">
                Daftar
            </button>
        </form>

        <div class="text-center mt-4">
            <span class="text-secondary">Sudah punya akun? </span>
            <a asp-page="/Auth/Login" class="font-semibold">Login</a>
        </div>
    </section>
</div>
