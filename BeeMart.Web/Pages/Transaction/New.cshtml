@page
@model BeeMart.Web.Pages.Transaction.NewModel
@using System.Globalization
@{
    ViewData["Title"] = "Transaksi Baru (POS)";
    var idCulture = new CultureInfo("id-ID");
    string FormatRupiah(decimal amount) => "Rp " + Math.Round(amount).ToString("N0", idCulture);
}

@Html.AntiForgeryToken()

<!-- Top POS Session & Invoice Banner -->
<section class="pos-meta-bar" aria-label="Informasi Transaksi Kasir">
    <div class="pos-meta-item">
        <span class="pos-meta-label">Nomor Invoice (Otomatis)</span>
        <div>
            <span id="pos-invoice-no" class="pos-invoice-code">@Model.NextInvoiceNo</span>
            <input type="hidden" id="pos-invoice-input" value="@Model.NextInvoiceNo" readonly />
        </div>
    </div>

    <div class="pos-meta-item">
        <span class="pos-meta-label">Kasir Bertugas</span>
        <span class="pos-meta-value" id="pos-cashier-display">@Model.CashierFullName (@Model.CashierUsername)</span>
    </div>

    <div class="pos-meta-item">
        <span class="pos-meta-label">Waktu Server / Real-Time</span>
        <span class="pos-meta-value font-mono" id="pos-realtime-clock">@DateTime.Now.ToString("M/d/yyyy, HH.mm.ss")</span>
    </div>
</section>

<!-- Dynamic Alert Container -->
<div id="pos-alert-container">
    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-danger" role="alert">
            <span>@Model.ErrorMessage</span>
            <button type="button" class="alert-close" data-dismiss="alert" aria-label="Close">&times;</button>
        </div>
    }
</div>

<!-- Main Two-Column POS Interface -->
<div class="pos-layout">
    <!-- LEFT COLUMN: Product Search & Catalog -->
    <section class="card card-amber-top" aria-labelledby="catalog-heading">
        <div class="card-header">
            <h2 class="card-title" id="catalog-heading">Cari &amp; Pilih Barang</h2>
            <span class="badge badge-secondary" id="catalog-count-badge">
                Total: @Model.ProductCatalog.TotalItems Barang
            </span>
        </div>

        <div class="card-body">
            <!-- Search Input Bar -->
            <div class="form-group">
                <label class="form-label" for="product-search-input">
                    Cari Barang (Ketik: Apel / Susu, lalu tekan Enter)
                </label>
                <div class="search-bar-wrapper">
                    <input type="text"
                           id="product-search-input"
                           class="search-input"
                           value="@Model.SearchTerm"
                           placeholder="Ketik nama barang..."
                           autocomplete="off" />
                    <button type="button" id="product-search-btn" class="btn btn-accent">Cari</button>
                    <button type="button" id="product-reset-btn" class="btn btn-secondary">Reset</button>
                </div>
            </div>

            <!-- Selected Product Dialog Panel (Barang Terpilih) -->
            <div id="selected-product-panel" class="selected-product-panel" style="display: none;">
                <div class="d-flex items-center justify-between mb-2">
                    <h3 class="text-accent" style="margin: 0;" id="selected-product-title">Barang Terpilih: -</h3>
                    <button type="button" id="selected-product-close-btn" class="btn btn-secondary btn-sm">Tutup</button>
                </div>
                <div class="grid-2 mb-3">
                    <div>
                        <span class="text-muted">Harga Satuan:</span>
                        <div class="price-text" id="selected-product-price">Rp 0</div>
                    </div>
                    <div>
                        <span class="text-muted">Sisa Stock:</span>
                        <div class="font-bold" id="selected-product-stock">0</div>
                    </div>
                </div>
                <div class="d-flex items-center gap-3 flex-wrap">
                    <label for="selected-product-qty" class="form-label" style="margin: 0;">Qty:</label>
                    <input type="number"
                           id="selected-product-qty"
                           class="form-control"
                           style="width: 100px;"
                           min="1"
                           value="1" />
                    <button type="button" id="selected-product-add-btn" class="btn btn-accent">
                        Masukkan ke Keranjang
                    </button>
                </div>
                <span id="selected-product-error" class="validation-error" style="display: none;"></span>
            </div>

            <!-- Product Results Table -->
            <div class="table-responsive">
                <table class="table table-striped" aria-label="Tabel Hasil Pencarian Barang">
                    <thead>
                        <tr>
                            <th>Nama Barang</th>
                            <th class="text-right">Harga</th>
                            <th class="text-center">Stock</th>
                            <th class="text-center">Aksi</th>
                        </tr>
                    </thead>
                    <tbody id="product-catalog-tbody">
                        @if (Model.ProductCatalog.Items.Count == 0)
                        {
                            <tr>
                                <td colspan="4" class="table-empty">Barang tidak ditemukan.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var product in Model.ProductCatalog.Items)
                            {
                                var isOutOfStock = product.Stock <= 0;
                                <tr data-product-id="@product.IdProduct"
                                    data-product-name="@product.ProductName"
                                    data-product-price="@product.Price.ToString(CultureInfo.InvariantCulture)"
                                    data-product-stock="@product.Stock">
                                    <td class="font-semibold">@product.ProductName</td>
                                    <td class="text-right price-text">@FormatRupiah(product.Price)</td>
                                    <td class="text-center">
                                        @if (isOutOfStock)
                                        {
                                            <span class="badge badge-danger">Habis (0)</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-success">@product.Stock</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <div class="d-flex justify-center gap-1">
                                            <button type="button"
                                                    class="btn btn-accent btn-sm js-select-product"
                                                    @(isOutOfStock ? "disabled" : "")>
                                                Pilih
                                            </button>
                                            <button type="button"
                                                    class="btn btn-primary btn-sm js-quick-add-product"
                                                    title="Tambah 1 ke Keranjang"
                                                    @(isOutOfStock ? "disabled" : "")>
                                                + Keranjang
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination Controls -->
            <div class="d-flex items-center justify-between flex-wrap mt-3 gap-2"
                 id="product-pagination-bar"
                 data-page="@Model.ProductCatalog.Page"
                 data-total-pages="@(Math.Max(1, Model.ProductCatalog.TotalPages))"
                 data-page-size="@Model.ProductCatalog.PageSize">
                <span class="text-muted" id="product-page-info">
                    Halaman @Model.ProductCatalog.Page dari @(Math.Max(1, Model.ProductCatalog.TotalPages))
                </span>
                <div class="pagination" style="margin-top: 0;" id="product-pagination-controls">
                    <button type="button"
                            class="page-link @(Model.ProductCatalog.Page <= 1 ? "disabled" : "")"
                            id="page-prev-btn"
                            @(Model.ProductCatalog.Page <= 1 ? "disabled" : "")>
                        &laquo; Prev
                    </button>
                    <span class="page-link active" id="page-current-badge">@Model.ProductCatalog.Page</span>
                    <button type="button"
                            class="page-link @(Model.ProductCatalog.Page >= Model.ProductCatalog.TotalPages ? "disabled" : "")"
                            id="page-next-btn"
                            @(Model.ProductCatalog.Page >= Model.ProductCatalog.TotalPages ? "disabled" : "")>
                        Next &raquo;
                    </button>
                </div>
            </div>
        </div>
    </section>

    <!-- RIGHT COLUMN: Cart (Daftar Belanjaan) & Checkout -->
    <section class="card card-amber-top" aria-labelledby="cart-heading">
        <div class="card-header">
            <h2 class="card-title" id="cart-heading">Daftar Belanjaan</h2>
            <button type="button" id="clear-cart-btn" class="btn btn-secondary btn-sm" disabled>
                Kosongkan
            </button>
        </div>

        <div class="card-body">
            <!-- Cart Items Table -->
            <div class="table-responsive mb-4">
                <table class="table" aria-label="Tabel Daftar Belanjaan">
                    <thead>
                        <tr>
                            <th>Nama Barang</th>
                            <th class="text-right">Harga</th>
                            <th class="text-center">Qty</th>
                            <th class="text-right">Subtotal</th>
                            <th class="text-center">Aksi</th>
                        </tr>
                    </thead>
                    <tbody id="cart-tbody">
                        <tr id="cart-empty-row">
                            <td colspan="5" class="table-empty">
                                Daftar belanjaan masih kosong. Silakan pilih barang dari katalog.
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <!-- Live Order Totals Summary -->
            <div class="pos-summary-box">
                <div class="pos-summary-row">
                    <span class="text-secondary font-semibold">Total Item:</span>
                    <span class="font-bold" id="summary-total-item">0 item</span>
                </div>
                <div class="pos-summary-row total-row">
                    <span class="font-bold" style="font-size: 1.05rem;">Total Belanja:</span>
                    <span class="price-total text-accent" id="summary-total-price">Rp 0</span>
                </div>
            </div>

            <!-- Payment & Customer Money Form -->
            <div class="form-group">
                <label class="form-label" for="payment-method-select">Metode Pembayaran:</label>
                <select id="payment-method-select" class="form-select" required>
                    @if (Model.PaymentMethods.Count == 0)
                    {
                        <option value="">-- Tidak ada metode pembayaran --</option>
                    }
                    else
                    {
                        @foreach (var pm in Model.PaymentMethods)
                        {
                            <option value="@pm.IdPaymentMethod">@pm.PaymentMethodName</option>
                        }
                    }
                </select>
            </div>

            <div class="form-group">
                <label class="form-label" for="customer-money-input">Uang Diterima (Customer Money) [Rp]:</label>
                <input type="number"
                       id="customer-money-input"
                       class="form-control"
                       min="0"
                       step="1000"
                       value="0"
                       placeholder="Masukkan nominal uang pelanggan..." />
                <div class="quick-cash-bar">
                    <button type="button" class="btn btn-secondary btn-sm js-quick-cash" data-cash="exact">Uang Pas</button>
                    <button type="button" class="btn btn-secondary btn-sm js-quick-cash" data-cash="50000">Rp 50.000</button>
                    <button type="button" class="btn btn-secondary btn-sm js-quick-cash" data-cash="100000">Rp 100.000</button>
                    <button type="button" class="btn btn-secondary btn-sm js-quick-cash" data-cash="200000">Rp 200.000</button>
                </div>
                <span id="customer-money-hint" class="validation-error" style="display: none;">
                    Uang diterima kurang dari total belanja.
                </span>
            </div>

            <!-- Live Change Display -->
            <div class="pos-summary-box">
                <div class="pos-summary-row">
                    <span class="font-semibold">Kembalian (Change):</span>
                    <span class="price-text text-success" style="font-size: 1.15rem;" id="summary-change">Rp 0</span>
                </div>
            </div>

            <!-- Submit Checkout Button -->
            <button type="button"
                    id="submit-transaction-btn"
                    class="btn btn-accent btn-lg btn-block"
                    disabled>
                Submit Transaksi
            </button>
        </div>
    </section>
</div>

<partial name="_ReceiptModal" />

@section Scripts {
    <script src="~/js/pos.js" asp-append-version="true"></script>
}
